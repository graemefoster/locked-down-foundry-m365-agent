@token=
@subscriptionid=
@agent=ghcpfileprocessoragent
@foundry=publicfoundryaustraliaeast
@project=proj-default
@rg=PublicFoundry2

POST https://{{foundry}}.services.ai.azure.com/api/projects/{{project}}/agents/{{agent}}?api-version=2025-11-15-preview
Content-Type: application/json
Authorization: Bearer {{token}}
Foundry-Features: HostedAgents=V1Preview

{
  "name": "{{agent}}",
  "definition": {
    "kind": "hosted",
    "container_protocol_versions": [
      {
        "protocol": "invocations",
        "version": "1.0.0"
      }
    ],
    "cpu": "0.5",
    "memory": "1Gi",
    "image": "grfacragents.azurecr.io/ghcpfileprocessor:0.3",
    "environment_variables": {
      "AZURE_AI_MODEL_DEPLOYMENT_NAME": "gpt-5.4"
    }
  },
  "description": "A sample Github Copilot SDK Agent."
}

### Hit the local responses API!
POST http://localhost:8088/invocations
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "input": "Hello!"
}
