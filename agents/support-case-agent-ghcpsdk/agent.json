{
  "object": "agent.version",
  "name": "support-case-agent-ghcpsdk",
  "description": "General IT support agent (GitHub Copilot SDK, dotnet_10) with GraeCRM / GraeIdentity / escalation skills, served through the model gateway.",
  "definition": {
    "kind": "hosted",
    "protocol_versions": [
      {
        "protocol": "invocations",
        "version": "1.0.0"
      }
    ],
    "cpu": "0.5",
    "memory": "1Gi",
    "code_configuration": {
      "runtime": "dotnet_10",
      "entry_point": [
        "dotnet",
        "support-case-agent-ghcpsdk.Agent.dll"
      ],
      "dependency_resolution": "bundled"
    },
    "environment_variables": {
      "MODEL_DEPLOYMENT_NAME": "gpt-5.4",
      "FOUNDRY_PROJECT_ENDPOINT": ""
    }
  }
}
