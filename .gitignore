# Compiled ARM templates (generated from bicep — do not commit)
*.json
# ...except the azd parameters file, which must be committed.
!infra/main.parameters.json
# ...and the bicep extension config (enables the microsoftGraphV1 extension).
!infra/bicepconfig.json
# ...and the agent evaluation datasets (input data for the nightly eval workflow).
!agents/**/eval-data.json
# ...and the per-agent network-integration manifests (token limits + M365/Foundry ingress flags,
# compiled into the APIM token policy + the YARP edge routes by the deploy-agent-network workflow).
!agents/**/agent-network.json
# ...and the MCP gateway config + per-agent rate-limit config (source of truth compiled into APIM).
!mcp/*.json
# ...and the App Service source that azd deploys as CODE (these are real app config/manifests,
# not compiled ARM): the Node MCP app's package manifests + the YARP app's appsettings.
!mcp/agent-tools/package.json
!mcp/agent-tools/package-lock.json
!apps/sample-gateway/appsettings.json
!apps/sample-gateway/appsettings.Development.json

# Bicep param files may contain secrets or deployment-specific values.
# Commit *.bicepparam only if all secrets have been removed.
# run-seed-agents.bicepparam contains deployment-specific GUIDs.
run-seed-agents.bicepparam

# Local settings
*.local.bicepparam
local.settings.json

# Azure Functions
test-agents/azure-functions/__pycache__/
test-agents/azure-functions/.python_packages/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# .NET build output
**/bin/
**/obj/

# Node dependencies (azd restores these during deploy; never commit them)
node_modules/
# Node build output (azd runs `npm run build` to regenerate the bundled MCP app on deploy)
mcp/agent-tools/dist/

# OS
.DS_Store
Thumbs.db
.azure

# drawio editor lock/temp files
*.dtmp
.$*.drawio.dtmp
*.log
agents/support-case-agent/
