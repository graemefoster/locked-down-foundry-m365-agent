# Compiled ARM templates (generated from bicep — do not commit)
*.json
# ...except the azd parameters file, which must be committed.
!infra/main.parameters.json
# ...and the bicep extension config (enables the microsoftGraphV1 extension).
!infra/bicepconfig.json
# ...and the agent evaluation datasets (input data for the nightly eval workflow).
!agents/**/eval-data.json
# ...and the MCP gateway config + per-agent rate-limit config (source of truth compiled into APIM).
!mcp/*.json

# Bicep param files may contain secrets or deployment-specific values.
# Commit *.bicepparam only if all secrets have been removed.
# run-seed-agents.bicepparam contains deployment-specific GUIDs.
run-seed-agents.bicepparam

# Local settings
*.local.bicepparam
local.settings.json

# Azure Functions
test-agents/azure-functions/__pycache__/
test-agents/azure-functions/.python_packages/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# .NET build output
**/bin/
**/obj/

# OS
.DS_Store
Thumbs.db
.azure
